# Copy to .env and adjust. Everything has safe dev defaults.

# --- Core ---
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=*

# --- Control-plane database ---
# Leave POSTGRES_DB unset to use sqlite (var/control.sqlite3) for local dev.
# POSTGRES_DB=salexa_control
# POSTGRES_USER=salexa
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=6432          # PgBouncer in production, 5432 direct otherwise

# --- Tenant databases ---
# sqlite (default, dev/test): one file per tenant under var/tenants/
# postgres (production): one database per tenant, created by the provisioner
TENANT_DB_ENGINE=sqlite
# TENANT_PG_HOST=127.0.0.1
# TENANT_PG_PORT=6432         # ALWAYS point tenants at PgBouncer in production
# TENANT_PG_USER=salexa
# TENANT_PG_PASSWORD=secret
# TENANT_PG_MAINTENANCE_DB=postgres  # used only for CREATE DATABASE

# --- SaaS URLs ---
PORTAL_BASE_URL=http://localhost:3000

# --- Billing ---
# "mock" (default) auto-approves payments — dev/test/E2E.
# Set to "razorpay" + fill the keys to take real payments.
BILLING_GATEWAY=mock
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx     # webhook URL: /api/billing/webhook/razorpay
BILLING_GST_RATE=18
BILLING_GRACE_DAYS=3
# Dunning sweep (suspend lapsed tenants): run daily ->
#   python manage.py billing_maintenance
