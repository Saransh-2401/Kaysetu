# KaySetu Production Environment
# ────────────────────────────────────────────────────────────────
# CHANGE ALL SECRETS BELOW before going live!

# --- Django ---
SECRET_KEY=Ks8Tp-m2xR9vQ7wL4jN6bY3hF5dA0cE1gZ8uI2oP
DEBUG=0
ALLOWED_HOSTS=api.kaysetu.in,ops.kaysetu.in,app.kaysetu.in

# --- PostgreSQL ---
PG_USER=kaysetu
PG_PASSWORD=CHANGE-ME-strong-password-here

# --- Gunicorn ---
WEB_CONCURRENCY=4

# --- SaaS ---
APP_NAME=KaySetu
PORTAL_BASE_URL=https://app.kaysetu.in
# kaysetu.in is included because the marketing site POSTs contact/demo leads
# to the API cross-origin. Without it every enquiry fails the CORS preflight.
CORS_ALLOWED_ORIGINS=https://ops.kaysetu.in,https://app.kaysetu.in,https://kaysetu.in,https://www.kaysetu.in

# --- Billing ---
# Set to "razorpay" and fill keys for real payments.
BILLING_GATEWAY=mock
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
BILLING_GST_RATE=18
BILLING_GRACE_DAYS=3

# --- Media / Image service (img.kaysetu.in) ---
# Same contract as the previous platform: POST <URL>/upload/<section> with an
# X-API-Key header. Without the key, file uploads are refused with a 503.
IMAGE_SERVICE_URL=https://img.kaysetu.in
IMAGE_SERVICE_API_KEY=CHANGE-ME-image-service-key
