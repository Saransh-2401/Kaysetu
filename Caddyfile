# KaySetu — Add these blocks to your VPS Caddyfile.
# Caddy obtains and renews SSL certificates automatically.
#
# The Docker containers bind to 127.0.0.1 only (docker-compose.prod.yml):
#   backend  → localhost:3001
#   frontend → localhost:3002   (SuperAdmin ops console)
#   portal   → localhost:3003   (tenant application)

# ── API (Django backend) ──────────────────────────────────────
api.kaysetu.kayease.com {
	header {
		X-Content-Type-Options    nosniff
		X-Frame-Options           DENY
		X-XSS-Protection          "1; mode=block"
		Referrer-Policy            strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	reverse_proxy localhost:3001
}

# ── Ops Console (SuperAdmin frontend) ─────────────────────────
ops.kaysetu.kayease.com {
	header {
		X-Content-Type-Options    nosniff
		X-Frame-Options           DENY
		X-XSS-Protection          "1; mode=block"
		Referrer-Policy            strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy localhost:3002
}

# ── Tenant Portal ─────────────────────────────────────────────
app.kaysetu.kayease.com {
	header {
		X-Content-Type-Options    nosniff
		X-Frame-Options           DENY
		X-XSS-Protection          "1; mode=block"
		Referrer-Policy            strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy localhost:3003
}
