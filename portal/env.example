# ==============================================
# KAYSETU 1.0 - Environment Variables Template
# ==============================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control
# ==============================================

# ------------------
# API Configuration
# ------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# ------------------
# Authentication
# ------------------
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_JWT_EXPIRY=3600
# Cookie names for auth tokens
NEXT_PUBLIC_AUTH_TOKEN_NAME=kaysetu_auth_token
NEXT_PUBLIC_REFRESH_TOKEN_NAME=kaysetu_refresh_token

# ------------------
# Application Info
# ------------------
NEXT_PUBLIC_APP_NAME=KaySetu
NEXT_PUBLIC_APP_VERSION=2.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ------------------
# Feature Flags
# ------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false
NEXT_PUBLIC_ENABLE_DEBUG_MODE=true

# ------------------
# Third-Party Services
# ------------------
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=

# Map Services (for Sales Agent routes)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------
# WebSocket (Optional)
# ------------------
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ------------------
# File Upload
# ------------------
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ------------------
# Pagination
# ------------------
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# ------------------
# Session
# ------------------
NEXT_PUBLIC_SESSION_TIMEOUT=1800000

# ==============================================
# Server-Side Only Variables (No NEXT_PUBLIC_)
# ==============================================

# JWT Secret (Keep this secret!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database (if using server-side features)
DATABASE_URL=

# Email Service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kaysetu.com

# ==============================================
# Production Environment Example
# ==============================================
# NEXT_PUBLIC_API_URL=https://api.kaysetu.kayease.com/api/v1
# NEXT_PUBLIC_APP_URL=https://kaysetu.kayease.com
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
# NEXT_PUBLIC_ENABLE_DEBUG_MODE=false
