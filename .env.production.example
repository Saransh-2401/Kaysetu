# KaySetu — production environment TEMPLATE.
#
#   cp .env.production.example .env.production   and fill in the real values.
#
# The real .env.production is gitignored on purpose: it holds live secrets, and
# when it was tracked a `git pull` silently overwrote the server's credentials.
# Never commit it.
#
# ⚠  ESCAPING: docker compose interpolates `$` in this file. A password like
#    ##KaySetu$2026  MUST be written  ##KaySetu$$2026  ($$ = a literal $), or
#    compose eats it and the backend authenticates with the wrong string.
#    Always verify what compose resolved before deploying:
#      docker compose -f docker-compose.prod.yml --env-file .env.production config \
#        | grep -m1 POSTGRES_PASSWORD

# --- Django ---
# Generate a fresh one, do NOT reuse any value that has been in git:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE-ME-generate-a-new-secret-key
DEBUG=0
ALLOWED_HOSTS=api.kaysetu.in,ops.kaysetu.in,app.kaysetu.in,localhost,127.0.0.1

# --- PostgreSQL ---
# PG_PASSWORD only takes effect when the data volume is FIRST created. On an
# existing deployment it must match the password already inside Postgres.
PG_USER=kaysetu
PG_PASSWORD=CHANGE-ME-strong-password-here

# --- Gunicorn ---
WEB_CONCURRENCY=4

# --- SaaS ---
APP_NAME=KaySetu
PORTAL_BASE_URL=https://app.kaysetu.in
# kaysetu.in + www are required: the marketing site POSTs leads cross-origin,
# and without them every contact/demo submission dies in the CORS preflight.
CORS_ALLOWED_ORIGINS=https://ops.kaysetu.in,https://app.kaysetu.in,https://kaysetu.in,https://www.kaysetu.in

# --- Billing ---
# "razorpay" activates real payments; anything else auto-approves (dev/E2E).
BILLING_GATEWAY=mock
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
BILLING_GST_RATE=18
BILLING_GRACE_DAYS=3

# --- Media / image service (img.kaysetu.in) ---
# POST <URL>/upload/<section> with an X-API-Key header. Without the key the API
# refuses uploads with 503 rather than saving a record whose file vanished.
IMAGE_SERVICE_URL=https://img.kaysetu.in
IMAGE_SERVICE_API_KEY=CHANGE-ME-image-service-key

# --- Google Maps (Portal: Sales Agent routes, Distributor map) ---
# Get a key from https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Maps JavaScript API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=CHANGE-ME-your-google-maps-api-key
